# Testiympäristö (ei salaisuuksia: kertakäyttöinen testikanta ja testitunnukset).
# Oletuksena testit käynnistävät oman Postgresin (embedded-postgres) porttiin 54330.
# Oman Postgresin voi käyttää asettamalla TEST_PG_EMBEDDED=false ja TEST_DATABASE_URL:n.
# Kannan nimen PITÄÄ päättyä _test, muuten testit kieltäytyvät ajamasta.
TEST_DATABASE_URL=postgresql://postgres:test@localhost:54330/paivakirja_test
TEST_PG_EMBEDDED=true
TEST_PG_PORT=54330
TEST_USERNAME=testaaja
TEST_PASSWORD=testi-salasana-123
JWT_SECRET=test-jwt-secret-ei-tuotantoon
PGSSL=false
STORAGE_DRIVER=local
NODE_ENV=test
