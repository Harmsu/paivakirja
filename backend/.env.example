# Paikallinen kehitys: SSH-tunneli UpCloudiin, esim.
#   ssh -L 15432:localhost:5432 sanna@<palvelin>
DATABASE_URL=postgresql://user:password@localhost:15432/paivakirja
# UpCloud pakottaa SSL:n -> true (tunnelin kautta myös true)
PGSSL=true
APP_USERNAME=
APP_PASSWORD_HASH=
JWT_SECRET=vaihda-pitkaan-satunnaiseen
JWT_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:5173

# Kuvat: UpCloud Object Storage (S3-yhteensopiva)
S3_ENDPOINT=
S3_REGION=europe-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Paikallinen testaus ilman bucketia (EI tuotannossa):
# STORAGE_DRIVER=local

NOMINATIM_USER_AGENT=paikka-ja-kuvapaivakirja/1.0
